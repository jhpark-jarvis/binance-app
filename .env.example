POSTGRES_DB=binance_ops
POSTGRES_USER=binance_ops
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://binance_ops:change-me@postgres:5432/binance_ops
REDIS_URL=redis://redis:6379/0

# Collector settings
SYMBOLS=BTCUSDT,ETHUSDT
KLINE_INTERVAL=1m
BOOTSTRAP_DAYS=7
BACKFILL_OVERLAP_MINUTES=2
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/stream

# Web settings
WEB_HOST=0.0.0.0
WEB_PORT=8000

